# ─── Inngest Swag Store — Local Environment ───────────────────────────────
# Copy to .env.local and fill in real values before running locally.
# .env.local is gitignored. Never commit real keys.

# ─── Stripe (test mode) ────────────────────────────────────────────────────
# Get these from Stripe Dashboard → Developers → API keys (test mode)
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Get this by running `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# The CLI prints a fresh `whsec_...` each time it starts.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# ─── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional local-only palette control. Leave unset to hide the Brand Lab toggle.
# SWAG_STORE_ENABLE_BRAND_LAB=1

# ─── Clerk Admin Auth ─────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME
ADMIN_EMAIL_ALLOWLIST=riley@inngest.com

# Local E2E only. Lets Playwright exercise /admin without a Clerk browser flow.
# Ignored in NODE_ENV=production.
# ADMIN_E2E_BYPASS=1
# ADMIN_E2E_EMAIL=riley@inngest.com

# ─── AI/API/MCP Access ────────────────────────────────────────────────────
# Used by the Inngest inventory document import validator.
OPENAI_API_KEY=sk_REPLACE_ME
INVENTORY_IMPORT_MODEL=gpt-4.1-mini

# Optional bootstrap bearer token for automation endpoints. You can also generate
# revocable DB-backed tokens from /admin → API Tokens.
#   /api/ai/products
#   /api/ai/discount-codes
#   /api/ai/orders
#   /api/mcp
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SWAG_STORE_API_TOKEN=REPLACE_ME
SWAG_STORE_API_ACTOR_EMAIL=ai-assistant@inngest.com

# Protects POST /api/inventory/reset, which reseeds Railway Postgres from the
# Notion-backed catalog in src/lib/catalog.ts.
SWAG_STORE_RESET_SECRET=REPLACE_ME

# ─── Railway/Postgres ─────────────────────────────────────────────────────
# Production source of truth for products, inventory, and orders.
# DATABASE_URL=postgresql://user:password@host:port/railway?sslmode=require

# ─── Inngest ──────────────────────────────────────────────────────────────
# INNGEST_DEV=1 routes the SDK to the local dev server (npx inngest-cli@latest dev).
# Without it, the SDK demands a signing key and 500s on /api/inngest.
INNGEST_DEV=1

# Production only — leave commented for local dev.
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# ─── Order Confirmation Email (Resend) ────────────────────────────────────
# Sends the customer order confirmation from the fulfill-order function via
# https://api.resend.com/emails. If either var is unset, the send-confirmation
# step is a graceful no-op (logs + returns { sent: false }) — safe to leave
# blank for local dev. Get a key from https://resend.com → API Keys.
# RESEND_API_KEY=re_REPLACE_ME
# From address must be on a domain verified in Resend.
# ORDER_EMAIL_FROM=Inngest Swag <swag@inngest.com>

# ─── Slack Low-Inventory Alerts ───────────────────────────────────────────
# Incoming webhook for low-stock alerts. For testing, configure this webhook to
# post to Sterling or a private test destination. Later, swap it for a channel
# webhook without code changes.
# LOW_STOCK_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/ME
# Optional Slack mention, e.g. <@U12345678>.
# LOW_STOCK_SLACK_MENTION=
# Notify when variant stock is at or below this number.
LOW_STOCK_THRESHOLD=5

# Encryption key for @inngest/middleware-encryption. Encrypts step output,
# function output, and event.data.encrypted before they hit Inngest's storage.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INNGEST_ENCRYPTION_KEY=REPLACE_ME

# ─── Google Sheets (orders fulfillment store) ─────────────────────────────
# Local dev: point at the SA key file.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/swag-store-sheets-key.json
# Production (Vercel etc.): set base64 of the key JSON instead, leave the
# path env var unset.
# GOOGLE_SERVICE_ACCOUNT_JSON=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50...

ORDERS_SHEET_ID=REPLACE_ME
ORDERS_SHEET_NAME=Sheet1

# Riley's inventory sheet import source. If unset, ORDERS_SHEET_ID is reused.
INVENTORY_SHEET_ID=REPLACE_ME
INVENTORY_SHEET_NAME=Inventory
