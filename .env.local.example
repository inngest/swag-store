# ─── Inngest Swag Store — Local Environment ───────────────────────────────
# Copy to .env.local and fill in real values before running locally.
# .env.local is gitignored. Never commit real keys.

# ─── Stripe (test mode) ────────────────────────────────────────────────────
# Get these from Stripe Dashboard → Developers → API keys (test mode)
# https://dashboard.stripe.com/acct_1TQxNnIu03N9q0rK/test/apikeys
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Get this by running `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# The CLI prints a `whsec_...` value when the listener starts.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# ─── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Inngest ──────────────────────────────────────────────────────────────
# Local dev: Inngest dev server doesn't require keys. Leave commented.
# Production:
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
